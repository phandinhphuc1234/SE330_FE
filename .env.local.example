# Main library API (port 8080) - not required for standalone payment testing
NEXT_PUBLIC_API_URL=http://localhost:8080

# Payment service backend (SE330_BE)
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:8081

# Set to "true" to test the /payment page WITHOUT the main login backend (port 8080).
# Must match the dev fallback in SE330_BE (auth.middleware.ts), which is automatically
# enabled when NODE_ENV != production.
NEXT_PUBLIC_PAYMENT_DEV_BYPASS_AUTH=true
